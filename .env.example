# ==============================================================================
# Gohar Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Model and Inference Service Configuration
# Default points to local Ollama on Windows/Linux:
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Optional API key for remote hosted inference (e.g., Bearer token):
OLLAMA_API_KEY=

# Model tag to use (default: gemma4:e2b)
GOHAR_MODEL=gemma4:e2b

# Ollama inference timeout in seconds (default: 300)
GOHAR_OLLAMA_TIMEOUT=300

# Server Binding
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated URLs for web clients)
GOHAR_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://gohar.onrender.com
